#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# .NET
DOTNET_FILES=$(echo "$STAGED_FILES" | grep -E '\.(cs|csproj)$' || true)

if [ -n "$DOTNET_FILES" ]; then
  echo "==> Running .NET checks..."
  echo "$DOTNET_FILES" | xargs -r dotnet format Vivo.slnx --include
  dotnet test Vivo.slnx --filter Category=Fast
  echo "$DOTNET_FILES" | xargs -r git add
fi

# WEB
WEB_FILES=$(echo "$STAGED_FILES" | grep '^src/Vivo.Web/' || true)

if [ -n "$WEB_FILES" ]; then
  echo "==> Running Web checks..."
  (cd src/Vivo.Web && npx lint-staged)
  (cd src/Vivo.Web && npm run test:once)
fi